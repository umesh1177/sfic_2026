VITE_API_URL=http://localhost:5000/api

# ==============================================================================
# CONFIGURABLE MAP TILE PROVIDER
# ==============================================================================
# For unrestricted production traffic, configure an enterprise tile proxy,
# self-hosted TileServer-GL, Stadia Maps, MapTiler, or CartoDB.
#
# Examples:
# OpenStreetMap Standard (Dev/Testing):
#   https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# CartoDB Positron (High-contrast civic base):
#   https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# Municipal Tile Server (Private GeoServer / TileServer-GL):
#   https://gis.navsarimunicipal.in/tiles/{z}/{x}/{y}.png

VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors | Navsari Municipal Corporation GIS
VITE_MAP_SUBDOMAINS=a,b,c
