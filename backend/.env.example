# ==============================================================================
# REAL MOBILE SMS OTP GATEWAY (Configure ANY ONE provider below)
# ==============================================================================
# SMS_PROVIDER=auto   # auto | twilio | 2factor | fast2sms | msg91 | textbelt | webhook
#
# Option 1: Twilio (Global + India — auto-falls back to Twilio Verify API on Free Trial accounts)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Optional; auto-created if omitted
#
# Option 2: 2Factor.in (India +91 Instant OTP)
# TWOFACTOR_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Option 3: Fast2SMS (India +91)
# FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FAST2SMS_ROUTE=otp
#
# Option 4: MSG91 (India +91)
# MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxx
#
# Option 5: Textbelt (Global SMS — key "textbelt" gives 1 free test SMS/day)
# TEXTBELT_API_KEY=your_textbelt_key

# ==============================================================================
# WEB PUSH (VAPID) — Auto-generated & saved in PostgreSQL if left blank
# ==============================================================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:swachhsetu@navsarimunicipal.gov.in
